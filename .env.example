# Reference list of environment variable NAMES only. This tool does not read a .env file:
# set keys as Windows user environment variables (see README), never in a file in this folder.
# Stage 1 (option evaluator) needs NO keys - it works entirely offline on pasted data.
# The keys below are only used from Stage 2 onward, after review.

# Finnhub (free tier) - quotes, company news, earnings calendar
FINNHUB_API_KEY=
# Polygon.io / Massive (free tier) - end-of-day grouped bars
POLYGON_API_KEY=
# CoinGecko Demo (free) - crypto market data
COINGECKO_DEMO_API_KEY=
# SEC EDGAR asks for a contact in the User-Agent header (no key). Example: "Your Name your@email"
SEC_USER_AGENT=
